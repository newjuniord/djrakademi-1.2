# Appwrite
PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
PUBLIC_APPWRITE_PROJECT=

# Clé serveur avec accès aux tables de l'application
APPWRITE_API_KEY=

# Identifiant marchand Plopplop (ne jamais utiliser le préfixe PUBLIC_)
PLOPPLOP_CLIENT_ID=

# Facultatif, seulement si Plopplop vous a fourni une clé API distincte
PLOPPLOP_API_KEY=

# Resend (ne jamais utiliser le préfixe PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@djrakademi.net
CONTACT_FROM_EMAIL=contact@djrakademi.net

# URL publique sans slash final, utilisée dans les liens de connexion post-achat
APP_URL=https://djrakademi.net

# Expéditeur transactionnel validé dans Resend (nom affiché facultatif)
PURCHASE_FROM_EMAIL=DJR Akademi <contact@djrakademi.net>

# Le domaine djrakademi.net doit être validé dans Resend
PASSWORD_RESET_FROM_EMAIL=DJR Akademi <noreply@djrakademi.net>
